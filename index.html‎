function drawPage(data, side) {
  const w = 1200, h = 1781, c = mk(w, h), x = c.getContext("2d");
  x.fillStyle = "#fff"; x.fillRect(0, 0, w, h);
  const INK = "#2a2626", RED = "#7a1d2b", GREY = "#6d6764";
  const outer = 96, inner = 136;
  const L = side === "left" ? outer : inner, R = side === "left" ? w - inner : w - outer;
  const top = 150, bottom = h - 120, gap = 48, colW = (R - L - gap) / 2;
  // cabeçalho corrente
  x.fillStyle = INK; x.textBaseline = "alphabetic";
  x.font = '34px "Bellefair"';
  tracked(x, data.num, side === "left" ? L : R, 98, 1, side === "left" ? "left" : "right");
  x.font = '27px "Bellefair"'; tracked(x, data.head, (L + R) / 2, 96, 6, "center");
  x.fillRect(L, 116, R - L, 1.5);
  // notas de rodapé
  const NF = '23px "Bellefair"', NL = 31; x.font = NF;
  const space = x.measureText(" ").width;
  const noteLines = [];
  data.notes.forEach(([ref, txt]) => {
    x.font = '500 15px "Gotham"'; const rw = x.measureText(ref).width + 10; x.font = NF;
    let line = [], lw = rw, first = true;
    txt.split(" ").forEach(word => {
      const ww = x.measureText(word).width;
      if (lw + ww > R - L && line.length) { noteLines.push({ ref: first ? ref : null, rw, words: line }); first = false; line = []; lw = 0; }
      line.push(word); lw += ww + space;
    });
    noteLines.push({ ref: first ? ref : null, rw, words: line, last: true });
  });
  const notesH = noteLines.length * NL + 34;
  let ny = bottom - notesH + 34 + 22;
  x.fillStyle = INK; x.fillRect(L, bottom - notesH + 8, 110, 1.5);
  noteLines.forEach(l => {
    let nx = L;
    if (l.ref) { x.font = '500 15px "Gotham"'; x.fillStyle = RED; x.fillText(l.ref, nx, ny - 1); nx += l.rw; }
    x.font = NF; x.fillStyle = x.strokeStyle = GREY; x.lineWidth = 1; x.fillText(l.words.join(" "), nx, ny); x.strokeText(l.words.join(" "), nx, ny); ny += NL;
  });
  // fluxo em duas colunas
  const colBottom = bottom - notesH - 10;
  x.fillStyle = "#b9b1ab"; x.fillRect(L + colW + gap / 2 - .75, top - 6, 1.5, colBottom - top);
  const BF = '29.5px "Bellefair"', LH = 42;
  let col = 0, y = top + 28, done = false;
  const colX = () => L + col * (colW + gap);
  const next = () => { col++; y = top + 28; if (col > 1) done = true; };
  for (const bl of data.blocks) {
    if (done) break;
    if (bl.h) {
      if (y + 120 > colBottom) next(); if (done) break;
      if (y > top + 40) y += 22;
      x.fillStyle = RED; x.font = '38px "Bellefair"'; tracked(x, bl.h, colX() + colW / 2, y + 8, 5, "center");
      x.fillStyle = GREY; x.font = '500 14.5px "Gotham"'; tracked(x, bl.s, colX() + colW / 2, y + 42, .6, "center");
      y += 92; continue;
    }
    x.font = BF; const sp = x.measureText(" ").width;
    x.font = '500 15px "Gotham"'; const numW = x.measureText(String(bl.v)).width + 7;
    x.font = BF;
    const words = bl.t.split(" ").map(t => ({ t, w: x.measureText(t).width }));
    const lines = []; let cur = [], cw = numW;
    words.forEach(wd => {
      if (cw + wd.w > colW && cur.length) { lines.push(cur); cur = []; cw = 0; }
      cur.push(wd); cw += wd.w + sp;
    });
    lines.push(cur);
    lines.forEach((ln, li) => {
      if (done) return;
      if (y > colBottom) { next(); if (done) return; }
      let lx = colX();
      if (li === 0) { x.font = '500 15px "Gotham"'; x.fillStyle = RED; x.fillText(String(bl.v), lx, y - 9); lx += numW; x.font = BF; }
      const tw = ln.reduce((a, b) => a + b.w, 0);
      const avail = colX() + colW - lx;
      let g = sp;
      if (li < lines.length - 1 && ln.length > 1) { const gg = (avail - tw) / (ln.length - 1); if (gg < sp * 2.6) g = gg; }
      x.fillStyle = INK;
      x.strokeStyle = INK; x.lineWidth = 1.3;
      ln.forEach(wd => { x.fillText(wd.t, lx, y); x.strokeText(wd.t, lx, y); lx += wd.w + g; });
      y += LH;
    });
    y += 4;
  }
