    for (const pm of [pagesL, pagesR]) { const cl = pm.material.uniforms.uCamL.value; cl.copy(camera.position); pm.worldToLocal(cl); }

    // indicador das abas
    ind.style.transform = `translateX(${indL.v}px)`; ind.style.width = Math.max(indR.v - indL.v, 0) + "px";

    renderer.render(scene, camera);
    requestAnimationFrame(frame);
  }
  applyMode(); dist.v = dist.t;
  requestAnimationFrame(t => { last = t0 = t; document.body.classList.add("ready"); frame(t); });
}
init().catch(e => { console.error(e); document.getElementById("err").textContent = "Não foi possível carregar a Bíblia 3D. Recarregue a página."; document.getElementById("err").style.display = "grid"; });
})();
</script>
