  const s = new THREE.Shape();
  s.moveTo(x0, z0); s.lineTo(x1 - r, z0); s.quadraticCurveTo(x1, z0, x1, z0 + r);
  s.lineTo(x1, z1 - r); s.quadraticCurveTo(x1, z1, x1 - r, z1); s.lineTo(x0, z1); s.lineTo(x0, z0);
  const g = new THREE.ExtrudeGeometry(s, { depth: C - 2 * bt, bevelEnabled: true, bevelThickness: bt, bevelSize: b, bevelSegments: 4, curveSegments: 14 });
  g.rotateX(Math.PI / 2); g.translate(0, C - bt, 0);
  const pos = g.attributes.position, nor = g.attributes.normal, n = pos.count;
  const uv = new Float32Array(n * 2), foil = new Float32Array(n);
  for (let i = 0; i < n; i++) {
