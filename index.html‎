  const svg = doc.documentElement;
  svg.querySelectorAll(":scope > rect").forEach(r => r.remove());
  const groups = svg.querySelectorAll(":scope > g");
  const symbolInner = groups[0].innerHTML;
  groups.forEach(g => g.setAttribute("fill", "#fff"));
  svg.setAttribute("viewBox", "330 325 1425 1222"); svg.setAttribute("width", "1425"); svg.setAttribute("height", "1222");
  const full = new XMLSerializer().serializeToString(svg);
  const sym = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 587.19 750.92" width="587.19" height="750.92"><g fill="#fff">${symbolInner}</g></svg>`;
